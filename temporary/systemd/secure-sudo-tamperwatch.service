[Unit]
Description=secure_sudo tamperwatch - real-time tamper attribution (runtime guard)
After=local-fs.target
OnFailure=secure-sudo-addon-failure@%n.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/secure-sudo-tamperwatch daemon
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=78
# fanotify needs CAP_SYS_ADMIN; the tamperer's executable may be anywhere, so
# /home and /tmp stay readable. Nothing outside its state and log is written.
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/secure_sudo /var/log/secure_sudo
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_KILL CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
# --- P2-2 hardening shared by every add-on (docs/ADDONS.md "Service hardening")
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# the add-on log can be shipped to a syslog collector (logging.conf)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
# fanotify is not in @system-service
SystemCallFilter=fanotify_init fanotify_mark
MemoryHigh=512M
MemoryMax=768M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
