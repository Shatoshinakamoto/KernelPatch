[Unit]
Description=secure_sudo add-on failure report for %i
# No OnFailure= here: a failing report must not start another report.

[Service]
Type=oneshot
ExecStart=/usr/libexec/secure-sudo/secure-sudo-addon-failure %i
# Writes the add-on log and runs notify_cmd (logging.conf), which may mail or
# post: /var stays writable, the rest of the system is read-only.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
# --- P2-2 hardening shared by every add-on (docs/ADDONS.md "Service hardening")
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# the add-on log can be shipped to a syslog collector (logging.conf)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
MemoryMax=64M
TasksMax=16
TimeoutStartSec=2min
