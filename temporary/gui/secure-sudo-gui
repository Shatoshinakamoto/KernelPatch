def load_conf(errors=None):
    """gui.conf, checked strictly like the guards' configs (ssaddon_conf):
    unknown keys, repeats, bad values and an unsafe owner/mode are errors,
    appended to @errors as "path:line: message"."""
    cfg = {"bind": "127.0.0.1", "port": 8790, "mode": "read_only"}
    errs = [] if errors is None else errors
    try:
        f = open(CONF)
    except FileNotFoundError:
        return cfg
    except OSError as e:
        errs.append(f"{CONF}: cannot be read: {e.strerror}")
        return cfg
    with f:
        st = os.fstat(f.fileno())
        if st.st_uid != 0:
            errs.append(f"{CONF}: not owned by root (uid {st.st_uid})")
        if st.st_mode & 0o022:
            errs.append(f"{CONF}: writable by group or others (mode {st.st_mode & 0o7777:04o})")
        seen = {}
        for n, line in enumerate(f, 1):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if "=" not in line:
                errs.append(f"{CONF}:{n}: not a 'key = value' line")
                continue
            k, v = (x.strip() for x in line.split("=", 1))
            if k not in ("bind", "port", "mode"):
                errs.append(f"{CONF}:{n}: unknown setting '{k[:64]}'")
                continue
            if k in seen:
                errs.append(f"{CONF}:{n}: {k} is set twice (first on line {seen[k]})")
                continue
            seen[k] = n
            if k == "mode":
                if v not in ("read_only", "admin"):
                    errs.append(f"{CONF}:{n}: mode: '{v[:64]}' is not read_only or admin")
                else:
                    cfg["mode"] = v
            elif k == "bind":
                if not re.fullmatch(r"[A-Za-z0-9.\-_:\[\]%]{1,63}", v):
                    errs.append(f"{CONF}:{n}: bind: '{v[:64]}' is not a host name or address")
                else:
                    cfg["bind"] = v
            else:
                if not re.fullmatch(r"[0-9]{1,5}", v) or not 1 <= int(v) <= 65535:
                    errs.append(f"{CONF}:{n}: port: '{v[:64]}' is not a port (1..65535)")
                else:
                    cfg["port"] = int(v)
    return cfg


def record_evidence(path, action, sample):
    """The same record the guards write (ssaddon_trust.c sst_evidence): what
    the file was before the console acted on it."""
    import hashlib
    rec = {"time": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
           "feature": "gui", "action": action, "path": path, "expected_sha256": ""}
    try:
        st = os.lstat(path)
        h = hashlib.sha256()
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(65536), b""):
                h.update(chunk)
        rec.update(state="file", sha256=h.hexdigest(), size=st.st_size,
                   mode="%04o" % (st.st_mode & 0o7777), uid=st.st_uid, gid=st.st_gid,
                   mtime=int(st.st_mtime), ctime=int(st.st_ctime), inode=st.st_ino,
                   sample=sample)
    except OSError:
        rec["state"] = "missing"
    os.makedirs(EVIDENCE, 0o700, exist_ok=True)
    fd = os.open(os.path.join(EVIDENCE, "gui.jsonl"),
                 os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        os.write(fd, (json.dumps(rec, sort_keys=True) + "\n").encode())
        os.fsync(fd)
    finally:
        os.close(fd)
    return rec


def check_written(name):
    """Run the owning guard's check-config; None if it passes or the guard is
    not installed, else its report."""
    exe = shutil.which(GUARD_BIN[CONF_CHECKER[name]])
    if not exe:
        return None
    rc, out = run([exe, "check-config"])
    return None if rc == 0 else out


def replace_checked(name, path, content):
    """Write @content to @path atomically; if the guard then reports a config
    error, put the previous file back and return the report."""
    try:
        with open(path, "rb") as f:
            old = f.read()
    except FileNotFoundError:
        old = None
    os.makedirs(ADDON_CONF, 0o755, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(content)
    os.chmod(tmp, 0o644)
    os.replace(tmp, path)
    bad = check_written(name)
    if bad is None:
        return None
    if old is None:
        os.unlink(path)
    else:
        with open(tmp, "wb") as f:
            f.write(old)
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    return bad


def get_token():
    os.makedirs(STATE, 0o700, exist_ok=True)
    os.chmod(STATE, 0o700)
    if os.path.exists(TOKEN_FILE):
        os.chmod(TOKEN_FILE, 0o600)   # never leave a pre-existing token readable
    try:
        with open(TOKEN_FILE) as f:
            t = f.read().strip()
            if t:
                return t
    except OSError:
        pass
    t = secrets.token_hex(24)
    fd = os.open(TOKEN_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    os.write(fd, t.encode())
    os.close(fd)
    return t


def run(args, timeout=15):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout + p.stderr
    except Exception as e:  # noqa: BLE001 - surfaced to the operator
        return 1, f"error: {e}"


def read_sysfs():
    knobs = {}
    try:
        for name in sorted(os.listdir(SYSFS)):
            path = os.path.join(SYSFS, name)
            try:
                with open(path) as f:
                    knobs[name] = f.read().strip()
            except OSError:
                knobs[name] = "(unreadable)"
    except OSError:
        pass
    return knobs


def latest_klog():
    try:
        logs = sorted(x for x in os.listdir(KLOG_DIR) if x.endswith(".log"))
        return os.path.join(KLOG_DIR, logs[-1]) if logs else None
    except OSError:
        return None


MAX_BODY = 512 * 1024      # a POST body larger than this is refused unread


def count_arg(q, default=200):
    """?n=: a whole number, 1..2000; anything else is a client error."""
    v = q.get("n", [str(default)])[0] or str(default)
    if not re.fullmatch(r"[0-9]{1,6}", v):
        raise ValueError("n must be a whole number")
    return max(1, min(int(v), 2000))


def tail(path, n):
    try:
        with open(path, errors="replace") as f:
            return f.readlines()[-n:]
    except OSError:
        return []


# bad-token throttle: 10 failures in 60 s lock the API for the rest of the
# window (the token is 192 bits, so this is about noise and logging, not about
# guessing)
_FAILS, _FAILS_LOCK = [], threading.Lock()
THROTTLE_MAX, THROTTLE_WINDOW = 10, 60


def throttled():
    now = time.monotonic()
    with _FAILS_LOCK:
        _FAILS[:] = [t for t in _FAILS if now - t < THROTTLE_WINDOW]
        return len(_FAILS) >= THROTTLE_MAX


def note_failure():
    with _FAILS_LOCK:
        _FAILS.append(time.monotonic())


def parse_ts(text):
    """Epoch seconds from the start of a guard log line (ISO 8601 with or
    without an offset), or None."""
    m = re.match(r"(\d{4})-(\d\d)-(\d\d)T(\d\d):(\d\d):(\d\d)(Z|[+-]\d{4})?", text)
    if not m:
        return None
    import calendar
    y, mo, d, h, mi, se = (int(x) for x in m.groups()[:6])
    t = calendar.timegm((y, mo, d, h, mi, se))
    z = m.group(7)
    if z and z != "Z":
        off = (int(z[1:3]) * 3600 + int(z[3:5]) * 60) * (1 if z[0] == "+" else -1)
        t -= off
    return t


def flatten(d, prefix=""):
    out = {}
    if isinstance(d, dict):
        for k, v in d.items():
            out.update(flatten(v, f"{prefix}{k}."))
    elif isinstance(d, list):
        out[prefix.rstrip(".")] = len(d)
    else:
        out[prefix.rstrip(".")] = d
    return out


def cli_json(args):
    """Run the CLI and return (rc, parsed JSON or None, text)."""
    exe = shutil.which(CLI)
    if not exe:
        return 127, None, f"{CLI} is not installed"
    rc, out = run([exe] + args)
    try:
        return rc, json.loads(out), out
    except ValueError:
        return rc, None, out


class Handler(BaseHTTPRequestHandler):
    server_version = "secure-sudo-gui"

    def _send(self, code, body, ctype="application/json"):
        if isinstance(body, (dict, list)):
            body = json.dumps(body).encode()
        elif isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        # no framing (clickjacking), no caching of anything this console shows,
        # no referrer, and a page that can only talk to itself
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; script-src 'self' 'unsafe-inline'; "
                         "style-src 'self' 'unsafe-inline'; connect-src 'self'; "
                         "frame-ancestors 'none'; base-uri 'none'; form-action 'none'")
        for k, v in getattr(self, "_extra", ()):
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *a):
        pass  # quiet

    # ---- GET ----
    def do_GET(self):
        try:
            return self._get()
        except ValueError as e:
            return self._send(400, {"error": str(e)})
        except Exception:  # noqa: BLE001 - never a traceback to the client
            return self._send(500, {"error": "internal error"})

    def _get(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        if u.path == "/" or u.path == "/index.html":
            # The page is static and holds no secret.
            try:
                with open(os.path.join(HERE, "index.html")) as f:
                    page = f.read()
            except OSError:
                page = "<h1>secure-sudo-gui</h1><p>index.html missing</p>"
            return self._send(200, page, "text/html; charset=utf-8")
        if u.path.startswith("/api/"):
            err = self._auth()
            if err:
                return self._send(*err)
        if u.path == "/api/status":
            return self._send(200, self.api_status())
        if u.path == "/api/logs":
            return self._send(200, self.api_logs(q))
        if u.path == "/api/memaccess":
            return self._send(200, self.api_memaccess(q))
        if u.path == "/api/config":
            return self._send(200, self.api_config_get(q))
        if u.path == "/api/health":
            return self._send(200, self.api_health())
        if u.path == "/api/eventloss":
            return self._send(200, self.api_eventloss())
        if u.path == "/api/timeline":
            return self._send(200, self.api_timeline(q))
        if u.path == "/api/policy":
            return self._send(200, self.api_policy(q))
        if u.path == "/api/evidence":
            return self._send(200, self.api_evidence(q))
        if u.path == "/api/evidence/export":
            body, name = self.api_evidence_export()
            self._extra = [("Content-Disposition", f'attachment; filename="{name}"')]
            return self._send(200, body)
        return self._send(404, {"error": "not found"})

    # ---- POST (token + same-host required) ----
    def _auth(self):
        """Token + Host check for every API call. Returns (code, body) on failure."""
        host = (self.headers.get("Host") or "").split(":")[0]
        if host not in ("127.0.0.1", "localhost", CFG["bind"]):
            return 403, {"error": "host not allowed"}
        # a browser sends Origin on cross-site and on POST requests: it must
        # name this console (CSRF); non-browser clients send none
        origin = self.headers.get("Origin")
        if origin is not None:
            if origin == "null" or urlparse(origin).hostname not in (
                    "127.0.0.1", "localhost", CFG["bind"]):
                return 403, {"error": "origin not allowed"}
        if throttled():
            return 429, {"error": "too many bad tokens; wait a minute"}
        given = (self.headers.get("X-SS-Token") or "").encode()
        if not hmac.compare_digest(given, TOKEN.encode()):
            sys.stderr.write(f"secure-sudo-gui: rejected API call {self.path.split('?')[0]} "
                             f"from {self.client_address[0]} (bad token)\n")
            note_failure()
            return 401, {"error": "bad or missing token"}
        return None

    def do_POST(self):
        try:
            return self._post()
        except Exception:  # noqa: BLE001 - never a traceback to the client
            return self._send(500, {"error": "internal error"})

    def _post(self):
        err = self._auth()
        if err:
            return self._send(*err)
        if CFG["mode"] != "admin":
            return self._send(403, {"error": "the console is read-only "
                                    "(mode = read_only in gui.conf); set mode = admin to change things"})
        ctype = (self.headers.get("Content-Type") or "").split(";")[0].strip().lower()
        if ctype != "application/json":
            return self._send(415, {"error": "Content-Type must be application/json"})
        cl = self.headers.get("Content-Length") or "0"
        # a negative length would read to EOF, a huge one would hold memory
        if not re.fullmatch(r"[0-9]{1,7}", cl) or int(cl) > MAX_BODY:
            self.close_connection = True
            return self._send(413, {"error": "body missing, malformed or too large"})
        try:
            data = json.loads(self.rfile.read(int(cl)) or b"{}")
        except Exception:
            return self._send(400, {"error": "bad json"})
        if not isinstance(data, dict):
            return self._send(400, {"error": "bad json"})
        u = urlparse(self.path)
        if u.path == "/api/config":
            return self._send(200, self.api_config_set(data))
        if u.path == "/api/setkey":
            return self._send(200, self.api_setkey(data))
        if u.path == "/api/action":
            return self._send(200, self.api_action(data))
        return self._send(404, {"error": "not found"})

    # ---- handlers ----
    def api_status(self):
        out = {"knobs": read_sysfs(), "guards": {}, "mode": CFG["mode"]}
        for feat, binname in GUARD_BIN.items():
            if shutil.which(binname):
                rc, txt = run([binname, "status"])
                out["guards"][feat] = {"installed": True, "status": txt.strip()}
            else:
                out["guards"][feat] = {"installed": False, "status": "not installed"}
        return out

    # ---- read-only views (P2-5) ----
    def api_health(self):
        """The CLI's own health report: the console shows what `secure-sudo
        health` says, it does not compute a second opinion."""
        rc, doc, text = cli_json(["health", "--json"])
        return {"rc": rc, "health": doc, "text": None if doc is not None else text.strip()}

    def api_eventloss(self):
        """Everything that says an event may have been lost: the daemon's
        counters from health, and the event_gap records in the kernel log."""
        rc, doc, text = cli_json(["health", "--json"])
        counters = {}
        if isinstance(doc, dict):
            for k, v in flatten(doc).items():
                if re.search(r"drop|gap|missing|suppress|fail|overflow", k, re.I):
                    counters[k] = v
        gaps = []
        path = latest_klog()
        if path:
            for ln in tail(path, 4000):
                if re.search(r'"event_type"\s*:\s*"(event_gap|event_sequence_error)"', ln):
                    gaps.append(ln.rstrip()[:500])
        return {"counters": counters, "gap_records": gaps[-50:],
                "gap_count": len(gaps), "health_rc": rc,
                "source": "secure-sudo health --json and the daemon event log"}

    def api_timeline(self, q):
        """Kernel events and every guard's log, merged into one list by time."""
        n = count_arg(q)
        rows = []
        path = latest_klog()
        if path:
            for ln in tail(path, n):
                ln = ln.rstrip("\n")
                row = {"source": "kernel", "time": None, "severity": "info", "text": ln[:600]}
                try:
                    rec = json.loads(ln)
                    if isinstance(rec, dict):
                        ns = rec.get("realtime_ns")
                        if isinstance(ns, int):
                            row["epoch"] = ns / 1e9
                        row["source"] = str(rec.get("source") or "kernel")[:32]
                        row["severity"] = "high" if rec.get("decision") == "deny" else "info"
                        row["text"] = " ".join(str(rec.get(k, "")) for k in
                                               ("event_type", "operation", "decision", "reason", "object")
                                               if rec.get(k))[:600] or ln[:600]
                except ValueError:
                    t = parse_ts(ln)
                    if t is not None:
                        row["epoch"] = t
                rows.append(row)
        sev = {"CRIT": "critical", "ERROR": "high", "WARN": "medium", "INFO": "info"}
        try:
            names = sorted(x for x in os.listdir(ALOG_DIR) if x.endswith(".log"))
        except OSError:
            names = []
        for name in names:
            for ln in tail(os.path.join(ALOG_DIR, name), n):
                ln = ln.rstrip("\n")
                m = re.match(r"\S+\s+(CRIT|ERROR|WARN|INFO)\b", ln)
                row = {"source": name[:-4], "time": None,
                       "severity": sev.get(m.group(1), "info") if m else "info", "text": ln[:600]}
                t = parse_ts(ln)
                if t is not None:
                    row["epoch"] = t
                rows.append(row)
        rows.sort(key=lambda r: r.get("epoch", 0))
        for r in rows:
            if "epoch" in r:
                r["time"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(r["epoch"]))
                del r["epoch"]
        return {"rows": rows[-n:], "note": "sorted by the time in each record; "
                "lines without a time sort first"}

    def api_policy(self, q):
        """Policy changes, straight from `secure-sudo history`, with the
        hash-chain check."""
        n = count_arg(q, 20)
        exe = shutil.which(CLI)
        if not exe:
            return {"error": f"{CLI} is not installed", "rows": []}
        rc, out = run([exe, "history", "-n", str(n), "--json"])
        rows = []
        for ln in out.splitlines():
            try:
                rec = json.loads(ln)
            except ValueError:
                continue
            if isinstance(rec, dict):
                rows.append(rec)
        vrc, vout = run([exe, "history", "--verify"])
        return {"rows": rows, "chain": "intact" if vrc == 0 else "BROKEN",
                "verify": vout.strip()[:2000]}

    def _evidence_records(self, limit):
        recs, blobs = [], []
        for root, _dirs, files in os.walk(EVIDENCE):
            for f in sorted(files):
                full = os.path.join(root, f)
                rel = os.path.relpath(full, EVIDENCE)
                if os.path.islink(full):
                    continue
                if f.endswith(".jsonl"):
                    for ln in tail(full, limit):
                        try:
                            rec = json.loads(ln)
                        except ValueError:
                            continue
                        if isinstance(rec, dict):
                            rec["file"] = rel
                            recs.append(rec)
                else:
                    try:
                        blobs.append({"file": rel, "size": os.path.getsize(full)})
                    except OSError:
                        pass
        recs.sort(key=lambda r: str(r.get("time", "")))
        return recs[-limit:], blobs[:limit]

    def api_evidence(self, q):
        n = count_arg(q)
        recs, blobs = self._evidence_records(n)
        return {"records": recs, "blobs": blobs, "root": EVIDENCE,
                "export": "/api/evidence/export"}

    def api_evidence_export(self):
        """Every evidence record as one JSON document for the operator to
        keep. Blob files are listed with size and SHA-256, never inlined."""
        import hashlib
        recs, blobs = self._evidence_records(MAX_EXPORT)
        for b in blobs:
            try:
                h = hashlib.sha256()
                with open(os.path.join(EVIDENCE, b["file"]), "rb") as f:
                    for chunk in iter(lambda: f.read(65536), b""):
                        h.update(chunk)
                b["sha256"] = h.hexdigest()
            except OSError:
                b["sha256"] = None
        doc = {"generated": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
               "root": EVIDENCE, "records": recs, "blobs": blobs}
        return json.dumps(doc, indent=1, sort_keys=True), \
            "secure-sudo-evidence-" + time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + ".json"

    def api_logs(self, q):
        src = (q.get("src", ["kernel"])[0])
        n = count_arg(q)
        if src == "kernel":
            path = latest_klog()
            lines = tail(path, n) if path else []
            return {"src": src, "path": path, "lines": lines}
        # guard log
        fname = re.sub(r"[^a-z0-9_]", "", src)
        if fname not in GUARD_BIN and fname not in ("gui", "failure"):
            return {"error": "unknown log"}
        path = os.path.join(ALOG_DIR, fname + ".log")
        return {"src": src, "path": path, "lines": tail(path, n)}

    def api_memaccess(self, q):
        n = count_arg(q)
        path = latest_klog()
        rows = []
        if path:
            for ln in tail(path, 4000):
                if "prguard: mem-access" in ln:
                    rows.append(ln.rstrip())
        return {"rows": rows[-n:], "hint":
                "enable the feed with: secure-sudo set prguard_observe 1"}

    def api_config_get(self, q):
        name = q.get("name", [""])[0]
        if name not in CONF_FILES:
            return {"error": "unknown config"}
        path = os.path.join(ADDON_CONF, CONF_FILES[name])
        try:
            with open(path) as f:
                return {"name": name, "path": path, "content": f.read()}
        except OSError as e:
            return {"name": name, "path": path, "content": "", "error": str(e)}

    def api_config_set(self, data):
        name = data.get("name")
        if not isinstance(name, str) or name not in CONF_FILES:
            return {"error": "unknown config"}
        content = data.get("content", "")
        if not isinstance(content, str):
            return {"error": "content must be text"}
        if len(content) > 256 * 1024:
            return {"error": "too large"}
        path = os.path.join(ADDON_CONF, CONF_FILES[name])
        bad = replace_checked(name, path, content)
        if bad is not None:
            return {"error": "rejected by check-config; the previous file was kept",
                    "report": bad}
        return {"ok": True, "path": path}

    def api_setkey(self, data):
        name, key, val = data.get("name"), data.get("key"), str(data.get("value", ""))
        if not isinstance(name, str) or name not in CONF_FILES or \
                not isinstance(key, str) or not re.fullmatch(r"[a-z_]{1,64}", key):
            return {"error": "bad name/key"}
        if not re.fullmatch(r"[A-Za-z0-9_./:\- ]{0,1024}", val):
            return {"error": "bad value"}
        path = os.path.join(ADDON_CONF, CONF_FILES[name])
        lines, found = [], False
        try:
            with open(path) as f:
                for ln in f:
                    if re.match(rf"\s*{re.escape(key)}\s*=", ln):
                        lines.append(f"{key} = {val}\n")
                        found = True
                    else:
                        lines.append(ln)
        except OSError:
            pass
        if not found:
            lines.append(f"{key} = {val}\n")
        bad = replace_checked(name, path, "".join(lines))
        if bad is not None:
            return {"error": "rejected by check-config; the previous file was kept",
                    "report": bad}
        return {"ok": True, "key": key, "value": val}

    def api_action(self, data):
        act = data.get("action")
        arg = str(data.get("arg", ""))
        if act == "scan" and arg in GUARD_BIN:
            return dict(zip(("rc", "out"), run([GUARD_BIN[arg], "scan"])))
        if act == "baseline" and arg in ("driverguard", "bootguard", "biosguard"):
            return dict(zip(("rc", "out"), run([GUARD_BIN[arg], "baseline"])))
        if act == "set_knob":
            # arg = "knob=value"; delegate to the CLI so kernel validation applies
            if "=" not in arg or not re.fullmatch(r"[a-z_]+=[\w.\-]+", arg):
                return {"error": "bad knob"}
            k, v = arg.split("=", 1)
            return dict(zip(("rc", "out"), run(["secure-sudo", "set", k, v])))
        if act == "autodetect_driverdir":
            r = os.uname().release
            self.api_setkey({"name": "driverguard", "key": "driver_dir",
                             "value": f"/lib/modules/{r}"})
            return {"ok": True, "driver_dir": f"/lib/modules/{r}"}
        if act == "autodetect_procallow":
            return self.autodetect_procallow()
        if act == "quarantine_pid":
            return self.quarantine_pid(arg)
        return {"error": "unknown action"}

    def autodetect_procallow(self):
        exes = set()
        for pid in os.listdir("/proc"):
            if not pid.isdigit():
                continue
            try:
                exe = os.readlink(f"/proc/{pid}/exe")
                if exe.startswith("/"):
                    exes.add(exe.split(" (deleted)")[0])
            except OSError:
                pass
        body = ("# auto-detected from running processes on "
                + time.strftime("%Y-%m-%d %H:%M:%S") + "\n"
                + "\n".join(sorted(exes)) + "\n")
        return self.api_config_set({"name": "procguard_allow", "content": body}) \
            | {"detected": len(exes)}

    def quarantine_pid(self, arg):
        if not re.fullmatch(r"[0-9]{1,10}", arg):
            return {"error": "pid must be numeric"}
        pid = int(arg)
        if pid <= 1 or pid in (os.getpid(), os.getppid()):
            return {"error": "refusing: PID 1 and the console itself are never killed"}
        # a pidfd pins the process: the kill below cannot hit a new process
        # that reused the number in the meantime
        try:
            pfd = os.pidfd_open(pid)
        except (OSError, AttributeError) as e:
            return {"error": f"no such process: {e}"}
        try:
            return self._quarantine(pid, pfd)
        finally:
            os.close(pfd)

    def _quarantine(self, pid, pfd):
        try:
            exe = os.readlink(f"/proc/{pid}/exe").split(" (deleted)")[0]
        except OSError as e:
            return {"error": f"cannot read exe: {e}"}
        qdir = os.path.join(STATE, "quarantine",
                            time.strftime("%Y%m%d%H"))
        os.makedirs(qdir, 0o700, exist_ok=True)
        dst = os.path.join(qdir, re.sub(r"[^A-Za-z0-9._-]", "_", os.path.basename(exe))
                           + f".{pid}.gz")
        try:
            # /proc/PID/exe is the binary that runs, even if its path was
            # replaced since; the path itself may be anything by now
            with open(f"/proc/{pid}/exe", "rb") as fi, gzip.open(dst, "wb") as fo:
                shutil.copyfileobj(fi, fo)
            os.chmod(dst, 0o600)
        except OSError as e:
            return {"error": f"compress failed: {e}"}
        try:
            record_evidence(exe, "quarantine", dst)
        except OSError as e:
            return {"error": f"evidence record failed, not killed: {e}", "stored": dst}
        try:
            signal.pidfd_send_signal(pfd, signal.SIGKILL)
        except OSError as e:
            return {"error": f"killed exe stored but kill failed: {e}", "stored": dst}
        return {"ok": True, "exe": exe, "stored": dst, "killed": pid}


def main():
    global TOKEN, CFG
    if os.geteuid() != 0:
        sys.stderr.write("secure-sudo-gui: must run as root\n")
        return 1
    errs = []
    CFG = load_conf(errs)
    if len(sys.argv) > 1 and sys.argv[1] == "check-config":
        for e in errs:
            print(e)
        print(f"{len(errs)} configuration problem(s); the console refuses to start "
              "until they are fixed" if errs else "configuration OK")
        return 1 if errs else 0
    if errs:
        for e in errs:
            sys.stderr.write(e + "\n")
        sys.stderr.write("secure-sudo-gui: refusing to start: configuration errors above\n")
        return 78
    TOKEN = get_token()
    srv = ThreadingHTTPServer((CFG["bind"], CFG["port"]), Handler)
    sys.stderr.write(f"secure-sudo-gui on http://{CFG['bind']}:{CFG['port']} "
                     f"(token in {TOKEN_FILE})\n")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
