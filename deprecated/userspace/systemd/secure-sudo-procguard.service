[Unit]
Description=secure_sudo ProcGuard process allowlist enforcer (runtime guard)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/secure-sudo-procguard daemon
Restart=on-failure
RestartSec=3
# ProcGuard must send signals to arbitrary processes, so it cannot be heavily
# sandboxed; it still drops new-privilege acquisition.
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
