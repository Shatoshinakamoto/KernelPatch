# Config fragment for the disposable test VM kernel (tests/vm/). Merged on
# top of x86_64 defconfig + kvm_guest.config by build-test-kernel.sh.
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_SECURE_SUDO=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,secure_sudo,bpf"
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_BPF_SYSCALL=y
CONFIG_PERF_EVENTS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_TEST_LKM=m
# a module RadioGuard knows by name (#19 module-name check)
CONFIG_MAC80211_HWSIM=m
CONFIG_USER_NS=y
CONFIG_BINFMT_MISC=y
# G4: the TPM driver core, built in as install.sh does. The guard is tested
# with device nodes of its own, so it needs no TPM; P2-1's policy measurement
# replays its PCR when boot-test.sh gives the guest a software TPM (tpm-tis).
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_SECURITY_SECURE_SUDO_MEASURE_PCR=13
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF5 is not set
