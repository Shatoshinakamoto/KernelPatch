# Overlay for tests/vm/kernel.config: stack secure_sudo with a major LSM
# (AppArmor) the way Ubuntu/Debian/SUSE kernels do, so slot counting and hook
# ordering are exercised with a full stack. Use with
#   EXTRA_CONFIG=tests/vm/kernel-stack-apparmor.config tests/vm/build-test-kernel.sh ...
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_AUDIT=y
CONFIG_LSM="landlock,lockdown,yama,apparmor,secure_sudo,bpf"
